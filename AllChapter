local function startFollowSaigomo()
    local char = player.Character or player.CharacterAdded:Wait()
    local hrp = char:WaitForChild("HumanoidRootPart")
    hitboxTask = task.spawn(function()
        while saigomoEnabled do
            enlargeHitbox()
            task.wait(0.2)
        end
    end)
    followTask = task.spawn(function()
        while saigomoEnabled do
            if hrp then
                local pos = getSaigomoPosition()
                if pos then
                    hrp.CFrame = CFrame.new(pos + Vector3.new(0, SAIGOMO_FLOAT_HEIGHT, 0))
                end
            end
            task.wait(0.05)
        end
    end)
end
local function stopFollowSaigomo()
    if followTask then pcall(function() task.cancel(followTask) end) followTask = nil end
    if hitboxTask then pcall(function() task.cancel(hitboxTask) end) hitboxTask = nil end
end
Control4:Toggle({
    Title = "Kill Saigomo",
    Default = false,
    Callback = function(state)
        saigomoEnabled = state
        if saigomoEnabled then
            startFollowSaigomo()
        else
            stopFollowSaigomo()
        end
    end
})
