local CharCache={Character=nil,Humanoid=nil,HumanoidRootPart=nil,BaseParts={}}
local function refreshCharCache(force)
local char=LocalPlayer.Character
if not force and char==CharCache.Character and CharCache.HumanoidRootPart and CharCache.HumanoidRootPart.Parent then
return CharCache.Character,CharCache.Humanoid,CharCache.HumanoidRootPart
end
CharCache.Character=char
CharCache.Humanoid=char and char:FindFirstChildOfClass("Humanoid") or nil
CharCache.HumanoidRootPart=char and char:FindFirstChild("HumanoidRootPart") or nil
CharCache.BaseParts={}
if char then
for _,part in ipairs(char:GetDescendants()) do
if part:IsA("BasePart") then table.insert(CharCache.BaseParts,part) end
end
end
return CharCache.Character,CharCache.Humanoid,CharCache.HumanoidRootPart
end
LocalPlayer.CharacterAdded:Connect(function()
task.defer(function() task.wait(0.05) refreshCharCache(true) end)
end)
LocalPlayer.CharacterRemoving:Connect(function()
CharCache.Character=nil CharCache.Humanoid=nil CharCache.HumanoidRootPart=nil CharCache.BaseParts={}
end)
refreshCharCache(true)
local NoclipEnabled = false
local noclipTask
Player:Toggle({
    Title = "Noclip",
    Default = false,
    Callback = function(s)
        NoclipEnabled = s
        if noclipTask then task.cancel(noclipTask) noclipTask = nil end
        if NoclipEnabled then
            refreshCharCache(true)
            noclipTask = task.spawn(function()
                while NoclipEnabled do
                    refreshCharCache()
                    for i=1,#CharCache.BaseParts do
                        local part=CharCache.BaseParts[i]
                        if part and part.Parent and part.CanCollide then part.CanCollide=false end
                    end
                    task.wait(0.1)
                end
            end)
        else
            local char=LocalPlayer.Character
            if char then
                for _,part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then part.CanCollide=true end
                end
            end
        end
    end
})
local TPWalkSpeed = 1
local TPWalkEnabled = false
local tpWalkTask = nil
Player:Slider({
